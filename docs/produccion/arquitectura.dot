digraph G {
  graph [rankdir=LR, fontname="Figtree", bgcolor="white", pad=0.4, nodesep=0.45, ranksep=0.9, label=<<b>MENTOR AI · Arquitectura de producción</b>>, labelloc=t, fontsize=22, fontcolor="#14193d"];
  node [shape=box, style="rounded,filled", fontname="Figtree", fontsize=13, color="#3451e1", fillcolor="#f4f6fc", fontcolor="#14193d", penwidth=1.6, margin="0.18,0.1"];
  edge [fontname="Figtree", fontsize=11, color="#5a6384", fontcolor="#3b466e", penwidth=1.3];

  usuario [label=<<b>Personas usuarias</b><br/>Navegador en computadora o celular>, shape=box, fillcolor="#c8f169", color="#3f6a06"];

  subgraph cluster_vercel { label=<<b>Vercel · Hobby</b> (CDN global)>; style="rounded,dashed"; color="#14193d"; fontcolor="#14193d"; fontsize=14;
    fe [label=<<b>Frontend React + Vite</b><br/>https://mentor-ai.vercel.app<br/>Sitio estático + reescritura /api/*>];
  }
  subgraph cluster_render { label=<<b>Render · Web Service</b> (Virginia, EE. UU.)>; style="rounded,dashed"; color="#14193d"; fontcolor="#14193d"; fontsize=14;
    api [label=<<b>API Node.js 22 + Express 5</b><br/>https://mentor-api.onrender.com/api/v1<br/>JWT en cookie httpOnly · RBAC · Zod<br/>8 agentes IA en services/agents>];
  }
  subgraph cluster_tidb { label=<<b>TiDB Cloud Starter</b> (AWS us-east-1)>; style="rounded,dashed"; color="#14193d"; fontcolor="#14193d"; fontsize=14;
    db [label=<<b>Base SQL compatible con MySQL 8</b><br/>62 tablas · migraciones Sequelize<br/>TLS obligatorio>, shape=cylinder, fillcolor="#eaeeff"];
  }
  subgraph cluster_n8n { label=<<b>n8n Cloud</b> (o n8n propio en Render)>; style="rounded,dashed"; color="#14193d"; fontcolor="#14193d"; fontsize=14;
    n8n [label=<<b>3 workflows</b><br/>Tipo de cambio diario<br/>Recordatorios diarios<br/>Baja de cuenta>, fillcolor="#fff4ee", color="#f0591a"];
  }
  subgraph cluster_ext { label=<<b>Servicios externos</b>>; style="rounded,dashed"; color="#14193d"; fontcolor="#14193d"; fontsize=14;
    ia [label=<<b>Anthropic Claude API</b><br/>Tutor y agentes>];
    hac [label=<<b>Ministerio de Hacienda</b><br/>Tipo de cambio (BCCR)>];
    nag [label=<<b>Nager.Date</b><br/>Feriados de Costa Rica>];
    smtp [label=<<b>Servidor SMTP</b><br/>Correos de recuperación y avisos>];
    gcp [label=<<b>Google Cloud (opcional)</b><br/>Vertex AI RAG · Cloud Storage · Drive>, style="rounded,filled,dashed"];
  }
  gh [label=<<b>GitHub</b><br/>Zael022/Mementor<br/>main · develop · feature/* · fix/*>, fillcolor="#e6eaf6"];

  usuario -> fe [label="HTTPS"];
  fe -> api [label="HTTPS · /api/* reescrito\nmismo origen para la cookie"];
  api -> db [label="TLS 1.2+ · puerto 4000"];
  api -> ia [label="HTTPS · clave en .env"];
  api -> hac [label="HTTPS · timeout 8 s"];
  api -> nag [label="HTTPS · caché 24 h"];
  api -> smtp [label="SMTP TLS"];
  api -> gcp [style=dashed, label="ADC (RAG_PROVIDER=vertex)"];
  api -> n8n [dir=both, label="  n8n → API: HTTPS + x-integration-key\l  API → n8n: webhook de baja\l", color="#f0591a", fontcolor="#d2480f"];
  n8n -> hac [color="#f0591a"];
  n8n -> smtp [color="#f0591a"];
  gh -> fe [style=dashed, label="push a main → despliegue"];
  gh -> api [style=dashed, label="push a main → despliegue"];
}
