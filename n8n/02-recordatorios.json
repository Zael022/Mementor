              "type": "string"
            },
            {
              "id": "Marcar fallido-s",
              "name": "status",
              "value": "failed",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "Marcar fallido",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1340,
        100
      ],
      "id": "rec-failed"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Agrupa los resultados del día en lotes de 500 para registrarlos en MENTOR AI.\nconst filas = $input.all().map((item) => item.json);\nconst lotes = [];\nfor (let i = 0; i < filas.length; i += 500) {\n  const lote = filas.slice(i, i + 500);\n  lotes.push({ json: { day: lote[0].day, results: lote.map((f) => ({ userId: Number(f.userId), status: f.status })) } });\n}\nreturn lotes;"
      },
      "name": "Agrupar resultados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1580,
        0
      ],
      "id": "rec-agrupar"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuración').first().json.apiUrl }}/integrations/daily-reminders/deliveries",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 15000
        }
      },
      "name": "Registrar envíos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1820,
        0
      ],
      "id": "rec-registrar"
    }
