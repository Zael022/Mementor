    {
      "id": "e5af1e19-a878-4e5a-a402-4a5921e72959",
      "name": "Pedir recordatorios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configuración').item.json.apiUrl }}/integrations/daily-reminders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "after",
              "value": "0"
            },
            {
              "name": "limit",
              "value": "200"
            }
          ]
        },
        "options": {
          "timeout": 15000,
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "after",
                    "value": "={{ $response.body.meta.nextCursor }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ $response.body.meta.nextCursor === null }}",
              "limitPagesFetched": true,
              "maxRequests": 500
            }
          }
        }
      }
    },
    {
      "id": "3d049019-b2bb-45c6-8a6a-db8d650a3967",
      "name": "Una persona por correo",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      }
    },
    {
      "id": "97d45d30-137b-4404-b7b5-a7c43225956c",
      "name": "Redactar mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Arma el texto del correo con las tareas y la racha pendientes; conserva a quién va para registrar el envío.\nconst lineas = $json.items.map((i) => i.type === 'racha' ? `• ${i.course}: ${i.title}` : `• ${i.course}: «${i.title}» vence ${new Date(i.dueAt).toLocaleString('es-CR', { timeZone: 'America/Costa_Rica' })}`);\nreturn { json: { userId: $json.userId, day: $json.day, email: $json.email, asunto: 'Tus pendientes de hoy en MENTOR AI', texto: `Hola, ${$json.name}:\\n\\nTe recordamos:\\n${lineas.join('\\n')}\\n\\nPuedes desactivar estos correos en Configuración.\\n\\n¡Tú puedes!` } };"
      }
    },
    {
      "id": "3ac8554a-5a1d-46b8-83e4-378695a0bc6f",
      "name": "Enviar recordatorio",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "fromEmail": "MENTOR AI <no-responder@tu-dominio.com>",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.asunto }}",
        "emailFormat": "text",
        "text": "={{ $json.texto }}",
        "options": {}
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "Marcar enviado-u",
              "name": "userId",
              "value": "={{ $('Redactar mensaje').item.json.userId }}",
              "type": "number"
            },
            {
              "id": "Marcar enviado-d",
              "name": "day",
              "value": "={{ $('Redactar mensaje').item.json.day }}",
              "type": "string"
            },
            {
              "id": "Marcar enviado-s",
              "name": "status",
              "value": "sent",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "Marcar enviado",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1340,
        -100
      ],
      "id": "rec-sent"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "Marcar fallido-u",
              "name": "userId",
              "value": "={{ $('Redactar mensaje').item.json.userId }}",
              "type": "number"
            },
            {
              "id": "Marcar fallido-d",
