    },
    {
      "id": "97d45d30-137b-4404-b7b5-a7c43225956c",
      "name": "Redactar mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Arma el texto del correo con las tareas y la racha pendientes.\nconst lineas = $json.items.map((i) => i.type === 'racha' ? `• ${i.course}: ${i.title}` : `• ${i.course}: «${i.title}» vence ${new Date(i.dueAt).toLocaleString('es-CR', { timeZone: 'America/Costa_Rica' })}`);\nreturn { json: { email: $json.email, asunto: 'Tus pendientes de hoy en MENTOR AI', texto: `Hola, ${$json.name}:\\n\\nTe recordamos:\\n${lineas.join('\\n')}\\n\\n¡Tú puedes!` } };"
      }
    },
    {
      "id": "3ac8554a-5a1d-46b8-83e4-378695a0bc6f",
      "name": "Enviar recordatorio",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "fromEmail": "MENTOR AI <no-responder@tu-dominio.com>",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.asunto }}",
        "emailFormat": "text",
        "text": "={{ $json.texto }}",
        "options": {}
      }
    }
  ],
