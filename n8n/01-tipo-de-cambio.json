      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "4a9de731-e518-48ad-bf55-8eb1e6a1a8db",
              "name": "apiUrl",
              "value": "https://TU-API.onrender.com/api/v1",
              "type": "string"
            },
            {
              "id": "d1985b3f-a244-42fb-95dd-563efec6bdbd",
              "name": "correoAviso",
              "value": "administracion@tu-institucion.cr",
