            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "391c0941-891d-4c30-8019-e853c5ab8ff9",
      "name": "Consultar Hacienda (BCCR)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "https://api.hacienda.go.cr/indicadores/tc/dolar",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "b9317b5f-b4d2-4c8c-b6f2-6c523e617c80",
      "name": "Preparar datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Acepta {dolar:{compra,venta}} o {compra,venta}.\nconst d = $json.dolar ?? $json;\nreturn [{ json: { date: String(d.venta.fecha).slice(0, 10), buy: Number(d.compra.valor), sell: Number(d.venta.valor) } }];"
      }
    },
    {
      "id": "4eb9483b-03c7-4e63-8fef-b4e53ebbb958",
      "name": "Guardar en MENTOR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuración').item.json.apiUrl }}/integrations/exchange-rates",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ date: $json.date, buy: $json.buy, sell: $json.sell }) }}"
      }
    },
    {
      "id": "1c7ace85-557e-4ba7-9079-b743cae7f233",
      "name": "Enviar resumen",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "fromEmail": "MENTOR AI <no-responder@tu-dominio.com>",
        "toEmail": "={{ $('Configuración').item.json.correoAviso }}",
        "subject": "=Tipo de cambio {{ $('Preparar datos').item.json.date }}",
        "emailFormat": "text",
        "text": "=Tipo de cambio de referencia del BCCR (vía Hacienda):\nCompra: ₡{{ $('Preparar datos').item.json.buy }}\nVenta: ₡{{ $('Preparar datos').item.json.sell }}\n\nGuardado en MENTOR AI para estimar el costo de la IA en colones.",
        "options": {}
      }
    }
  ],
