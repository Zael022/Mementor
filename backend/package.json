{
  "name": "mentor-ai-backend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "admin:create": "node src/scripts/createPlatformAdmin.js",
    "lint": "eslint .",
    "test": "cross-env NODE_ENV=test node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.0.0",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "mysql2": "^3.0.0",
    "nodemailer": "^10.6.1",
    "sequelize": "^6.0.0",
    "unpdf": "^1.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jszip": "^3.10.2",
    "sequelize-cli": "^6.0.0",
    "supertest": "^7.0.0",
    "umzug": "^3.8.0"
  }
}
