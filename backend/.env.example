NODE_ENV=development
PORT=3001
# En producción: la URL pública del frontend (por ejemplo https://mentor-ai.vercel.app).
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Base de datos de desarrollo (créala vacía antes de migrar).
# Motor: mysql (en tu computadora, el normal) o postgres (Supabase en la nube). Si se deja vacío se usa mysql.
DB_DIALECT=mysql
# Alternativa a DB_HOST…DB_PASSWORD: una sola URL (es lo que entrega Supabase en «Connect → Session pooler»).
# DATABASE_URL=postgresql://postgres.<proyecto>:<contraseña>@aws-0-<región>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mentor_ai
DB_USER=
DB_PASSWORD=

# Base de datos aislada para las pruebas automáticas (debe ser distinta a la anterior).
TEST_DB_DIALECT=mysql
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_NAME=mentor_ai_test
TEST_DB_USER=
TEST_DB_PASSWORD=

# Sesiones
# Firma de los JWT de sesión (mínimo 32 caracteres; genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Horas de vida del token de sesión.
JWT_EXPIRES_HOURS=8
# Costo de bcrypt para las contraseñas (12 recomendado).
BCRYPT_ROUNDS=12

# ---------- Producción ----------
# Detrás de un proxy o balanceador (Cloud Run, nginx), indica cuántos hay delante (normalmente 1)
# o sus direcciones (loopback, 10.0.0.0/8…). Vacío = sin proxy. Nunca uses «true».
TRUST_PROXY=
# memory = límites por IP en cada proceso (una sola instancia).
# mysql  = límites compartidos entre varias instancias del backend.
RATE_LIMIT_STORE=memory

# ---------- Generación de respuestas (tutor) ----------
# Sin estos valores el tutor responde AI_NOT_CONFIGURED y el resto de la plataforma funciona.
# AI_PROVIDER admite: anthropic | openai. Con anthropic el chat usa streaming real (SDK oficial).
# AI_MODEL: identificador disponible en tu cuenta (por ejemplo claude-opus-5-5); verifícalo en la consola del proveedor.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Opcional: endpoint completo compatible (por ejemplo https://api.anthropic.com/v1/messages).
AI_BASE_URL=

# Router de modelos por tarea (opcional). Si una variable falta, se usa AI_MODEL.
# Rápido: anuncios, resúmenes de lección, Coach de estudio y analista. Avanzado: tutor, retroalimentación,
# generador de preguntas y cumplimiento. Sin nombres de modelos en el código: se eligen aquí.
AI_MODEL_RAPIDO=
AI_MODEL_AVANZADO=
# Cambiar el nivel de un agente sin tocar código: AI_TIER_<AGENTE>=rapido|avanzado (por ejemplo AI_TIER_STUDY_COACH=avanzado).

# Caché de respuestas reutilizables (hoy solo el resumen de lección, por institución). on por defecto; off la apaga.
AI_RESPONSE_CACHE=on
AI_RESPONSE_CACHE_TTL_HOURS=168
# Prompt caching del proveedor para bloques largos y estables (la lección completa). Solo Anthropic lo marca;
# en servicios compatibles con OpenAI la caché de prefijos es automática. El mínimo depende del modelo (512 a 4096 tokens).
AI_PROMPT_CACHE=off
AI_PROMPT_CACHE_MIN_TOKENS=1024

# Señal de vida del chat en vivo (milisegundos): evita que un proxy corte la conexión mientras se busca.
SSE_PING_MS=15000

# ---------- Consumo ----------
# Consultas por persona en 24 horas y tope por institución (la plataforma puede fijar otro por institución).
AI_DAILY_LIMIT_PER_USER=40
AI_DAILY_LIMIT_PER_INSTITUTION=2000
# Documentos (materiales y archivos de Drive) que el tutor puede consultar por institución.
MAX_DOCUMENTS_PER_INSTITUTION=500

# ---------- Recuperación de fuentes ----------
# local  = búsqueda por palabras en MySQL (sin Google Cloud; ideal para desarrollo y pruebas).
# vertex = RAG Engine de Google Cloud (API de Vertex AI): búsqueda por significado, un corpus por curso.
RAG_PROVIDER=local

# Solo para RAG_PROVIDER=vertex. Las credenciales NO van aquí: se usan Application Default Credentials (ADC).
GOOGLE_CLOUD_PROJECT=
# Región compatible con RAG Engine. us-central1, us-east1 y us-east4 piden lista de acceso; europe-west3/4 son GA.
GOOGLE_CLOUD_LOCATION=europe-west4
# Bucket privado (misma región) donde MENTOR escribe el texto de cada versión publicada.
RAG_GCS_BUCKET=
# Prefijo administrado por MENTOR dentro del bucket; la limpieza solo actúa aquí.
RAG_GCS_PREFIX=mentor-ai
RAG_TOP_K=6
# Distancia vectorial máxima aceptada. Vacío = sin filtro. Calíbrala en un proyecto de prueba.
RAG_VECTOR_DISTANCE_THRESHOLD=
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=100
# Opcional: modelo de embeddings de Google para corpus nuevos (vacío = el predeterminado de RAG Engine).
RAG_EMBEDDING_MODEL=

# ---------- Google Drive ----------
# Tamaño máximo que MENTOR descarga por archivo y cada cuántos minutos sincroniza (0 = solo manual).
DRIVE_MAX_FILE_MB=10
DRIVE_SYNC_INTERVAL_MINUTES=0

# ---------- Archivos subidos ----------
# Dónde se guardan los originales (materiales y fotos de perfil):
#   local = disco del servidor (desarrollo, o un servidor con disco persistente y respaldo).
#   gcs   = bucket privado de Cloud Storage con ADC; el disco solo se usa como paso temporal.
#   supabase = bucket privado de Supabase Storage (rama despliegue-nube).
# En Render gratis el disco se borra al reiniciar: usa gcs o supabase.
STORAGE_DRIVER=local
STORAGE_GCS_BUCKET=
STORAGE_GCS_PREFIX=mentor-ai/originales
# Supabase Storage: URL del proyecto, clave secreta (sb_secret_…, solo en el backend) y bucket PRIVADO.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=mentor-originales
SUPABASE_STORAGE_PREFIX=originales
# Carpeta local (y temporal en gcs), relativa a backend/.
UPLOAD_DIR=storage/uploads
UPLOAD_MAX_MB=10
# Cada cuántos minutos se borran archivos huérfanos administrados por MENTOR (0 = nunca).
UPLOAD_RECONCILE_MINUTES=60

# ---------- Retención de datos (0 = no borrar) ----------
# Días que se conserva el texto de versiones reemplazadas que ninguna respuesta cita.
VERSION_TEXT_RETENTION_DAYS=30
# Días de detalle de consumo; lo anterior se resume por mes en ai_usage_monthly.
AI_USAGE_DETAIL_DAYS=90
# Días sin actividad tras los cuales se borra una conversación con el tutor (con sus citas).
AI_CHAT_RETENTION_DAYS=365
# Cada cuántos minutos se aplica la retención (1440 = una vez al día).
RETENTION_INTERVAL_MINUTES=1440
# Zona horaria que decide qué día es para la racha diaria.
APP_TIMEZONE=America/Costa_Rica

# Correo saliente (recuperación de contraseña y avisos de baja). Sin SMTP_HOST esas funciones responden con un error claro.
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MENTOR AI <no-responder@tu-dominio.com>

# APIs externas públicas (sin clave). Se pueden cambiar si el proveedor mueve su dirección.
EXCHANGE_RATE_URL=https://api.hacienda.go.cr/indicadores/tc/dolar
HOLIDAYS_URL=https://date.nager.at/api/v3/PublicHolidays
# Precio por millón de tokens del modelo, en USD, para estimar el costo en colones (déjalo vacío si no lo conoces).
AI_PRICE_INPUT_USD_PER_MTOK=
AI_PRICE_OUTPUT_USD_PER_MTOK=
# Tarifas opcionales por modelo, array JSON de objetos {provider,model,input,output}; sin clave ni precio supuesto.
AI_MODEL_PRICES_JSON=
# Límite diario de usos de los asistentes de IA por persona.
AGENT_DAILY_LIMIT_PER_USER=30
# Cuota independiente del tutor; incluye reservas en curso y fallas, excluye avisos sin evidencia.
AGENT_DAILY_LIMIT_PER_INSTITUTION=500

# n8n: clave compartida (mínimo 32 caracteres) que n8n envía en x-integration-key.
N8N_INTEGRATION_KEY=
# Con DELETION_PROCESSOR=n8n las bajas se procesan en el workflow 3 (si no responde, se procesan aquí).
DELETION_PROCESSOR=app
N8N_DELETION_WEBHOOK_URL=

# Bases en la nube con TLS (Supabase, TiDB Cloud, Aiven). El certificado siempre se verifica.
# Supabase usa una autoridad propia: descárgala en Database Settings → SSL Configuration y pon su ruta en DB_SSL_CA
# o su contenido completo en DB_SSL_CA_PEM (así se configura en Render).
DB_SSL=false
DB_SSL_CA=
DB_SSL_CA_PEM=
# Conexiones simultáneas máximas a la base (en el pooler gratuito de Supabase conviene 5).
DB_POOL_MAX=10

# Modo de prueba (ADR 0011): cuentas de prueba por rol y botón «Acceso rápido de prueba».
# Apagado por defecto. Con on, el backend crea las cuentas al arrancar. No lo dejes encendido en uso real.
DEMO_MODE=off
# Contraseña de las cuentas de prueba (por defecto MentorPrueba2026).
DEMO_PASSWORD=
